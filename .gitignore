# Rust build artifacts
/target/
**/*.rs.bk
Cargo.lock.bak

# Per-project cache (LanceDB, model downloads, embeddings)
# These belong in ~/.cache/schema/, NOT inside the repo. Listed here as
# a defensive guard in case someone accidentally creates them locally.
/data/
/.cache/
/models/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Snapshot test pending acceptance (insta)
*.snap.new

# E2E (Python pytest) — local-only artefacts
tests/e2e/__pycache__/
tests/e2e/.pytest_cache/
tests/e2e/.venv/

# Claude Code project metadata (machine-local)
.claude/

# Consumer-side MCP wiring (ADR-0030). `.mcp.json` is regenerated
# locally by `schema mcp-config --shim` (or legacy `schema mcp-config`
# for Shape A). Carries a bearer token under Shape A; under Shape B
# it is per-machine and rotates with the daemon.
.mcp.json
